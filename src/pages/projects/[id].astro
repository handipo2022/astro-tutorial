---
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const markdownFiles = Object.values(
    import.meta.glob("../../content/projects/*.md", { eager: true })
  ) as any[];

  return markdownFiles.map((file) => {
    const filename = file.file.split("/").pop().replace(".md", "");
    return {
      params: { id: filename },
      props: { project: file },
    };
  });
}
const pageTitle = "Projects";
const { project } = Astro.props;
// Destructured 'image' directly since your frontmatter array is named 'image'
const { title, image = [], description, demolink } = project.frontmatter;
const { Content } = project;
---

<Layout title={pageTitle}>
  <div class="container-fluid animate-fade-in-up">
    <!-- Back to Overview & Demo Link -->
    <div class="d-flex flex-row align-items-center justify-content-left gap-2 mb-3">
      <a href="/gallery" class="btn btn-secondary btn-sm">
        <i class="bi bi-arrow-left me-2"></i> Back to Projects
      </a>
      {demolink?.url && (
        <a href={demolink.url} class="btn btn-primary btn-sm" target="_blank" rel="noopener noreferrer">
          <i class="bi bi-link"></i> Demo Link
        </a>
      )}
    </div>

    <div class="d-flex flex-column justify-content-center align-items-center">
      <!-- Project Image Frame -->
      {Array.isArray(image) && image.length > 0 ? (
        <div id="projectCarousel" class="carousel slide w-100" data-bs-ride="carousel" style="max-width: 400px;">
          <div class="carousel-inner rounded shadow-sm bg-light">
            {image.map((imgSrc: string, index: number) => (
              <div class={`carousel-item ${index === 0 ? "active" : ""}`}>
                <div class="d-flex justify-content-center align-items-center" style="height: 350px;">
                  <img
                  src={imgSrc}
                  class="img-fluid object-fit-contain p-2 rounded-4"
                  style="max-width: 100%; max-height: 100%; width: auto; height: auto;"
                  alt={`${title} screenshot ${index + 1}`}
                />
                </div>
                
              </div>
            ))}
          </div>
          
          {image.length > 1 && (
            <>
              <button
                class="carousel-control-prev"
                type="button"
                data-bs-target="#projectCarousel"
                data-bs-slide="prev"
              >
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button
                class="carousel-control-next"
                type="button"
                data-bs-target="#projectCarousel"
                data-bs-slide="next"
              >
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            </>
          )}
        </div>
      ) : typeof image === "string" ? (
        <!-- Fallback if a legacy markdown file provides a simple string path instead of an array -->
        <img src={image} class="img-fluid rounded shadow-sm" alt={title} style="max-width: 400px;" />
      ) : null}

      <!-- Project Markdown Details -->
      <h1
        class="fw-bold text-primary mb-2 mt-4"
        style="font-family: 'Courier New', Courier, monospace;"
      >
        {title}
      </h1>
      <p
        class="text-muted fw-bold"
        style="font-family: 'Courier New', Courier, monospace;"
      >
        {description}
      </p>
      <hr class="w-100 my-4 border-light-subtle" />

      <!-- Render compiled HTML from your Markdown here -->
      <div class="container my-4 markdown-body text-secondary">
        <Content />
      </div>
    </div>
  </div>
</Layout>

<!-- CLIENT-SIDE SCRIPT FOR BOOTSTRAP INITIALIZATION -->
<script>
  import "bootstrap/dist/js/bootstrap.bundle.min.js";
</script>

<style>
  .markdown-body :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    color: #212529;
  }
  .markdown-body :global(ul) {
    padding-left: 1.25rem;
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
