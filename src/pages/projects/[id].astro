---
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const markdownFiles = Object.values(
    import.meta.glob("../../content/projects/*.md", { eager: true })
  ) as any[];

  return markdownFiles.map((file) => {
    // Extract the filename from file path to use as the ID slug
    const filename = file.file.split("/").pop().replace(".md", "");
    return {
      params: { id: filename },
      props: { project: file },
    };
  });
}
const pageTitle = "Projects";
const { project } = Astro.props;
const { title, image, description } = project.frontmatter;
const { Content } = project;
---

<Layout title={pageTitle}>
  <div class="container my-5 animate-fade-in-up">
    <!-- Back to Overview -->
    <a href="/../gallery" class="btn btn-outline-secondary btn-sm mb-4">
      <i class="bi bi-arrow-left me-2"></i> Back to Projects
    </a>

    <div class="row g-5">
      <!-- Project Image Frame -->
      <div class="col-12 col-md-6">
        <img
          src={image.url}
          alt={image.alt}
          class="img-fluid rounded-4 shadow-sm w-100 object-fit-cover"
          style="max-height: 400px;"
        />
      </div>

      <!-- Project Markdown Details -->
      <div class="col-12 col-md-6">
        <h1 class="fw-bold text-dark mb-2 font-monospace">{title}</h1>
        <p class="text-muted leading-relaxed mb-4">{description}</p>
        <hr class="my-4 border-light-subtle" />

        <!-- Render compiled HTML from your Markdown here -->
        <div class="markdown-body text-secondary">
          <Content />
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Optional simple styling targeting the rendered markdown tags */
  .markdown-body :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    color: #212529;
  }
  .markdown-body :global(ul) {
    padding-left: 1.25rem;
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
