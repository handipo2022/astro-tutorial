---
import Layout from "../layouts/Layout.astro";

const pageTitle = "Homepage";
---

<Layout title={pageTitle}>
  <div class="d-flex flex-column align-items-center">
    <img
      class="img-fluid rounded-circle object-fit-cover mb-3 mt-5 border border-dark border-1"
      style="width: 200px; height: 200px;"
      src="/public/images/profile_example.jpg"
      alt="Profile Picture"
    />
    <p class="text-primary fw-bold font-monospace">
      Web Developer , Mobile Developer , Embedded Programmer
    </p>
    <p class="font-sans-serif text-center">
      Hi , I am Zhou Han Bao, a passionate web and mobile developer also
      embedded programmer. I love creating innovative solutions and exploring
      new technologies. Welcome to my personal website where you can find my
      projects, blog posts, and more about my work in the tech world.
    </p>
  </div>
</Layout>
